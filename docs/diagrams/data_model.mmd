    owner_pin_credentials {
        SMALLINT credential_id PK
        UUID owner_user_id UK
        VARCHAR owner_name
        BYTEA pin_salt
        BYTEA pin_hash
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }
    owner_action_audit {
        UUID owner_action_id PK
        UUID owner_user_id FK
        UUID device_id FK
        VARCHAR action
        UUID reference_id
        JSONB details
        TIMESTAMP created_at
    }
    customers {
        UUID customer_id PK
        VARCHAR full_name
        VARCHAR phone_number UK
        TEXT address
        DECIMAL pending_balance
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }
    sales_invoices {
        UUID invoice_id PK
