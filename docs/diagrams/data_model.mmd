    authorised_devices {
        UUID device_id PK
        VARCHAR device_guid UK
        VARCHAR device_name
        VARCHAR role
        TEXT device_public_key
        BOOLEAN is_active
        TIMESTAMP last_login_at
        TIMESTAMP first_authorized_at
        TIMESTAMP created_at
        TIMESTAMP updated_at
    }
    device_auth_challenges {
        VARCHAR challenge_id PK
        UUID device_id FK
        BYTEA nonce
        TIMESTAMP expires_at
    }
    daily_gold_rates {
        UUID rate_id PK
        DATE rate_date UK
        DECIMAL rate_999_sell
        DECIMAL rate_49_sell
        DECIMAL rate_999_buy
        DECIMAL rate_fine_gatti_buy
        TIMESTAMP created_at
        TIMESTAMP updated_at
